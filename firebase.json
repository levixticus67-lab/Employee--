{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "artifacts/jojo-collections/dist/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/product/**",
        "function": "ogPreview"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
