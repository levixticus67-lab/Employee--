{
  "hosting": {
    "public": "artifacts/jojo-collections/dist/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/og/product/:productId",
        "destination": "https://jojo-collections-api.onrender.com/api/og/product/:productId",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
